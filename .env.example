# Root URL of the Flutter web build under test.
BASE_URL=https://dev-naas-admin.mismarapp.com/

# Account used by the auth setup project to produce a reusable storageState.
TEST_USER_EMAIL=user@example.com
TEST_USER_PASSWORD=your_password_here

# How long a screen must stay put before it counts as settled, in milliseconds.
# Must exceed the gap between the first login screen and the app's self-reload.
# See README "Tuning the stability window" for how to measure it.
FLUTTER_STABILITY_WINDOW_MS=4000
