{
  "name": "naas-ui-poc-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright end-to-end tests for the NaaS Flutter web UI",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:anonymous": "playwright test --project=anonymous",
    "test:authenticated": "playwright test --project=authenticated",
    "report": "playwright show-report",
    "codegen": "playwright codegen",
    "typecheck": "tsc --noEmit",
    "postinstall": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.7",
    "typescript": "^5.7.0"
  }
}
